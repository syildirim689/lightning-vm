# Values come from .env via compose.yaml; scripts/install.sh (domain | behind-proxy | local-only) sets them.
#   PANEL_SITE           ":80" = plain HTTP on any host name (loopback / SSH tunnel / behind another proxy)
#                        "panel.example.com" = automatic HTTPS for that name (ACME HTTP-01/TLS-ALPN on 80/443)
#   ACME_CA              Let's Encrypt production by default; the staging URL avoids rate limits while testing
#   TRUSTED_PROXY_CIDRS  only these peers may set X-Forwarded-*; everyone else's headers are replaced
{
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	servers {
		trusted_proxies static {$TRUSTED_PROXY_CIDRS:127.0.0.1/32}
		trusted_proxies_strict
	}
}

# One client address goes upstream: the one Caddy worked out itself ({client_ip}: the peer, or what a proxy listed in
# TRUSTED_PROXY_CIDRS reported, read from the right). Caddy's default appends to the chain such a proxy passed on, and
# with it whatever the client wrote in front; this replaces the chain, so no client-written entry reaches the API.
# X-Forwarded-Host and X-Forwarded-Proto need nothing here: Caddy sets them itself (the Host and scheme it was asked
# with) and keeps incoming ones only from a proxy in TRUSTED_PROXY_CIDRS, which behind-proxy mode relies on.
(client_address) {
	header_up X-Forwarded-For {client_ip}
	header_up -Forwarded
	header_up -X-Real-IP
}

{$PANEL_SITE::80} {
	# Your own certificate when one was uploaded (install.sh domain --tls custom, or the panel); empty otherwise.
	import /etc/caddy/site.d/*.caddy
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	# Metrics are for Prometheus on the internal network only.
	handle /api/metrics* {
		respond 404
	}
	# Alertmanager posts alerts to the API on the internal network; never from outside.
	handle /api/internal/* {
		respond 404
	}
	# Browser console WebSocket -> console gateway (same host and TLS as the panel).
	handle /console/ws {
		reverse_proxy console:8080 {
			import client_address
		}
	}
	# Administrators' host terminal -> terminal service (only while it is turned on; 502 otherwise).
	handle /terminal/ws {
		reverse_proxy terminal:8080 {
			import client_address
		}
	}
	# VMware HTML Console SDK files the operator downloads from Broadcom (not shipped; see console-sdk/README.md).
	handle_path /console-sdk/* {
		root * /srv/console-sdk
		file_server
	}
	handle_path /api/* {
		# Above the API's largest route limit (ticket attachments, 9 MB); the API has the real, per-route limits.
		request_body {
			max_size 10MB
		}
		reverse_proxy api:4000 {
			import client_address
		}
	}
	handle {
		reverse_proxy web:3000 {
			import client_address
		}
	}
	# The access log holds no usable secret. Some travel in the URL: the password-reset token is a path segment
	# (/api/auth/reset-password/<token>), and token, code, state and session_id are query values of the sign-in
	# link, the single sign-on callback and the payment return. The same URL comes back in the Referer of the
	# next request and in the Location of a redirect, so all three fields get the one replacement (one regexp per
	# field: a second filter on a field would replace the first). The CAPTCHA answer is a request header and is
	# left out. Caddy itself already leaves out Cookie, Set-Cookie and Authorization.
	# The same masks: deploy/observability/otel.yaml (collector) and scripts/install.sh mask_secrets (panel copy).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "(/reset-password/)[^/?&]+|([?&](token|code|state|session_id)=)[^&]+" "$1$2***"
				request>headers>Referer regexp "(/reset-password/)[^/?&]+|([?&](token|code|state|session_id)=)[^&]+" "$1$2***"
				resp_headers>Location regexp "(/reset-password/)[^/?&]+|([?&](token|code|state|session_id)=)[^&]+" "$1$2***"
				request>headers>X-Captcha-Response delete
			}
		}
	}
}
