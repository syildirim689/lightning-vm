{
  "name": "@lightning-vm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "tsc && node --test test/*.test.mjs",
    "test:integration": "tsc && node --test --test-concurrency=1 test/integration/*.test.mjs",
    "migrate": "node dist/cli.js migrate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "bullmq": "6.4.0",
    "fastify": "5.12.7",
    "ioredis": "^5.6.1",
    "pg": "8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "fastify": "$fastify"
  }
}
