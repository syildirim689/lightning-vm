    "@nestjs/platform-fastify": "11.2.8",
    "better-auth": "1.7.12",
    "bullmq": "6.4.0",
    "fastify": "5.12.7",
    "ioredis": "^5.6.1",
    "ldapts": "9.2.0",
    "mailchecker": "6.0.21",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
