#!/bin/bash
# A pretend virt-xml: records the network a domain was moved to.
set -u
n=""; net=""
while [ $# -gt 0 ]; do case "$1" in --connect) shift ;; --edit) shift ;; --network) net=$2; shift ;; *) n=$1 ;; esac; shift; done
printf ' vnet0       network   %s   virtio   52:54:00:00:00:01\n' "${net#network=}" > "$FAKE/dom/$n/nics"
echo "Domain '$n' defined successfully."
